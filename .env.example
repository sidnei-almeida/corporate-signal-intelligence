# Application
APP_ENV=development
PORT=8000
# Optional extra CORS origins (comma-separated, spaces OK after commas)
# CORS_ORIGINS=http://192.168.0.10:3000
DATA_DIR=data
MODELS_DIR=models
MODEL_PATH=models/isolation_forest_anomaly_pipeline.joblib

# Groq executive briefings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional database (Neon PostgreSQL)
DATABASE_URL=
# auto | csv | database
DATA_SOURCE=auto
BRIEFING_PROMPT_VERSION=v2

# External data providers
SEC_USER_AGENT=corporate-signal-intelligence/1.0 your-email@example.com
STOOQ_API_KEY=
ALPHA_VANTAGE_API_KEY=
